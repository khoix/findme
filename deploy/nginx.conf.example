# FindMe is normally mounted inside main-server at /findme, in which case it is
# served through the main-server proxy block and needs no location block here.
#
# Use the block below only when running FindMe standalone (node standalone.cjs).
# Standalone serves under the same /findme prefix, so the prefix is forwarded
# as-is rather than stripped.

location /findme/ {
    proxy_pass http://127.0.0.1:3210;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    # Screenshots can be up to 12 MB.
    client_max_body_size 16m;
}
