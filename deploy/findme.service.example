[Unit]
Description=FindMe location receiver
After=network.target

[Service]
Type=simple
WorkingDirectory=/var/www/html/findme
EnvironmentFile=/var/www/html/findme/.env
ExecStart=/usr/bin/node /var/www/html/findme/server.cjs
Restart=on-failure
RestartSec=3
User=www-data
Group=www-data

[Install]
WantedBy=multi-user.target
